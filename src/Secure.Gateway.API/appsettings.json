{
  // Host header allow-list (Host-header injection / cache poisoning). Set to your public host names in production.
  "AllowedHosts": "localhost;127.0.0.1;[::1]",

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Expressions" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Yarp": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gateway-.json",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 104857600,
          "retainedFileCountLimit": 14,
          "shared": true,
          "flushToDiskInterval": "00:00:02"
        }
      }
    ]
  },

  "OpenTelemetry": {
    // e.g. "http://otel-collector:4317" - leave empty to disable trace/metric export.
    "OtlpEndpoint": ""
  },

  "Kestrel": {
    "AddServerHeader": false,
    "Limits": {
      "MaxRequestBodySize": 10485760,
      "MaxRequestHeaderCount": 64,
      "MaxRequestHeadersTotalSize": 32768,
      "MaxRequestLineSize": 8192,
      "MaxConcurrentConnections": 10000,
      "MaxConcurrentUpgradedConnections": 1000,
      "KeepAliveTimeout": "00:01:00",
      "RequestHeadersTimeout": "00:00:15",
      "Http2": {
        "MaxStreamsPerConnection": 100,
        "MaxRequestHeaderFieldSize": 16384,
        "HeaderTableSize": 4096
      }
    }
  },

  "Authentication": {
    "Jwt": {
      // OIDC issuer, e.g. "https://login.microsoftonline.com/<tenant>/v2.0" or "https://<tenant>.auth0.com/"
      "Authority": "",
      "Audience": ""
    },
    "ApiKey": {
      "HeaderName": "X-API-Key",
      // SHA-256 hashes only. Generate: dotnet run --project src/Secure.Gateway.API -- hash-key <key>
      "Clients": []
    }
  },

  "Gateway": {
    "Compression": {
      "Enabled": true,
      "EnableForHttps": true,
      "ZstdLevel": 3,
      "BrotliLevel": "Fastest",
      "GzipLevel": "Fastest",
      "StripUpstreamAcceptEncoding": true
    },
    "SecurityHeaders": {
      "Enabled": true,
      "HstsMaxAgeSeconds": 31536000,
      "HstsIncludeSubDomains": true,
      "HstsPreload": false
    },
    "RequestValidation": {
      "Enabled": true,
      "MaxUrlLength": 4096,
      "MaxQueryParameters": 64,
      "MaxHeaderValueLength": 8192
    },
    "Waf": {
      "Mode": "Block",
      "MaxBodyInspectionBytes": 1048576,
      "RejectUninspectableBodies": true,
      "ExcludedPaths": [],
      "DisabledRules": []
    },
    "RateLimiting": {
      "Enabled": true,
      "GlobalTokenLimit": 200,
      "GlobalTokensPerPeriod": 100,
      "GlobalReplenishmentSeconds": 1,
      "DefaultPermitLimit": 600,
      "DefaultWindowSeconds": 60,
      "DefaultSegmentsPerWindow": 6,
      "StrictPermitLimit": 10,
      "StrictWindowSeconds": 60,
      "ConcurrencyLimitPerClient": 50
    },
    "IpFilter": {
      "Allow": [],
      "Deny": []
    },
    "Cors": {
      "AllowedOrigins": [],
      "AllowCredentials": false
    },
    "ForwardedHeaders": {
      // IPs/CIDRs of your load balancer / ingress. Only these may set X-Forwarded-For.
      "KnownProxies": [],
      "ForwardLimit": 1
    }
  },

  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "backend",
        "Order": 1,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "strict",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "public-api": {
        "ClusterId": "backend",
        "Order": 10,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "standard",
        "Match": { "Path": "/api/public/{**catch-all}" }
      },
      "secure-api": {
        "ClusterId": "backend",
        "Order": 100,
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "standard",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "backend": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:01:00"
          }
        },
        "HttpClient": {
          "SslProtocols": [ "Tls12", "Tls13" ],
          "DangerousAcceptAnyServerCertificate": false,
          "MaxConnectionsPerServer": 1024,
          "EnableMultipleHttp2Connections": true
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30",
          "VersionPolicy": "RequestVersionOrLower",
          "AllowResponseBuffering": false
        },
        "Destinations": {
          "primary": { "Address": "http://localhost:5100/" }
        }
      }
    }
  }
}
