{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "[{@t:HH:mm:ss} {@l:u3}] {#if CorrelationId is not null}({CorrelationId}) {#end}{Substring(SourceContext, LastIndexOf(SourceContext, '.') + 1)}: {@m}\n{@x}",
            "theme": "Serilog.Templates.Themes.TemplateTheme::Code, Serilog.Expressions"
          }
        }
      }
    ]
  },
  "Gateway": {
    "SecurityHeaders": { "HstsMaxAgeSeconds": 0 },
    "Cors": { "AllowedOrigins": [ "http://localhost:3000", "https://localhost:3000" ] }
  }
}
